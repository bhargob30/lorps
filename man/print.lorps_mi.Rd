\name{print.lorps_mi}
\alias{print.lorps_mi}
\title{Print a LoRPS Multiple-Imputation Fit}
\description{Displays matrix dimensions, the number of missing entries,
the selected or fixed rank, the number of components, and the retained draws.}
\usage{\method{print}{lorps_mi}(x, ...)}
\arguments{
  \item{x}{An object of class \code{lorps_mi}.}
  \item{...}{Further arguments; currently unused.}
}
\value{The input object, invisibly.}
\seealso{\code{\link{lorps_mi}}}
